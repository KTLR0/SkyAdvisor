{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkyAdvisor recommendation response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "goal", "actions"],
  "properties": {
    "contractVersion": { "const": 1 },
    "goal": { "enum": ["general", "farming", "mining", "combat"] },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "title", "whatToDo", "whyItFitsGoal", "supportingFactIds"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "whatToDo": { "type": "string", "minLength": 1, "maxLength": 600 },
          "whyItFitsGoal": { "type": "string", "minLength": 1, "maxLength": 600 },
          "supportingFactIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  }
}
