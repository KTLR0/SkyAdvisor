{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkyAdvisor model recommendation plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "goal", "actions"],
  "properties": {
    "contractVersion": { "type": "integer", "const": 2 },
    "goal": { "enum": ["general", "farming", "mining", "combat"] },
    "actions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "kind", "focusFactId", "reason", "supportingFactIds"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
          "kind": { "enum": ["train_skill", "grow_collection", "review_inventory"] },
          "focusFactId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "reason": { "enum": ["goal_alignment", "next_level", "next_collection_tier", "recorded_progress", "known_item"] },
          "supportingFactIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    }
  }
}
