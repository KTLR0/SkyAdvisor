# MongoDB Atlas connection. URI may include <username> and <password> placeholders,
# or may be an Atlas URI without credentials; database.js applies the credentials.
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=mongodb+srv://<username>:<password>@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=skyadvisor

# Required only for explicit SkyBlock fetches.
HYPIXEL_API_KEY=

# Optional, server-only; missing key returns saved-fact fallback recommendations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional; defaults to 3001.
PORT=3001
